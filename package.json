{
  "name": "pawpause",
  "version": "1.0.10",
  "description": "A pixel desktop pet that helps you pause before you burn out.",
  "author": "zebangeth",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "corepack pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "corepack pnpm build && electron-builder --mac --win --publish never",
    "dist:mac": "corepack pnpm build && electron-builder --mac --publish never",
    "dist:mac:arm64": "corepack pnpm build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "corepack pnpm build && electron-builder --mac --x64 --publish never",
    "dist:win": "corepack pnpm build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.pawpause.app",
    "productName": "PawPause",
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/notarize-artifacts.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "forceCodeSigning": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "PawPause uses Apple Events to ask System Events which app and window are currently active, so distraction detection can warn you when blocked apps or keywords appear."
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "sign": true,
      "title": "PawPause",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "angziii",
        "repo": "PawPause"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "petdex_pets",
        "to": "petdex_pets"
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "7.29.6",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.1.2",
      "brace-expansion@5": "5.0.8",
      "esbuild": "0.28.1",
      "fast-uri@3": "3.1.4",
      "form-data": "4.0.6",
      "js-yaml@4": "4.3.0",
      "postcss": "8.5.25",
      "sharp": "0.35.3",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "undici@6": "6.27.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}
